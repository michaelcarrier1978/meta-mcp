# Server
PORT=3000
NODE_ENV=development

# Database (Railway Postgres or any Postgres URL)
DATABASE_URL=postgresql://user:password@localhost:5432/meta_mcp

# Meta App Credentials
# Create an app at https://developers.facebook.com
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Must match the redirect URI registered in your Meta app's Facebook Login settings
META_REDIRECT_URI=http://localhost:3000/auth/meta/callback

# Optional: a shared secret for protecting the /tenants admin endpoint
ADMIN_SECRET=change_me_in_production
